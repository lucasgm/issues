// parseInputLine parses a line in the format "name:X version:Y" and returns the name and version.
func parseInputLine(line string) (name, version string, ok bool) {
	for _, part := range strings.Fields(line) {
		kv := strings.SplitN(part, ":", 2)
		if len(kv) != 2 {
			continue
		}
		switch strings.ToLower(kv[0]) {
		case "name":
			name = kv[1]
		case "version":
			version = kv[1]
		}
	}
	ok = name != ""
	return
}

func constructAQLQuery(name, version string) string {
	namePattern := name + "*"
	if version != "" {
		namePattern = name + "*" + version + "*"
	}
	query := fmt.Sprintf(`items.find({
    "type": "file",
    "name": {"$match": "%s"},
	"$and": [
        {"name": {"$nmatch": "*.xml*"}},
        {"name": {"$nmatch": "*.snapshot*"}},
		{"name": {"$nmatch": "*.ci.sig*"}}
	]
    }).include("repo", "path", "name", "created", "type", "property")`, namePattern)
	return query
}

// constructDockerAQLQuery builds an AQL query for Docker images stored in Artifactory.
// Docker images are stored as manifest.json files under a path of <image>/<tag>/.
func constructDockerAQLQuery(imageName, tag string) string {
	var pathPattern string
	if tag != "" {
		pathPattern = imageName + "/" + tag
	} else {
		pathPattern = imageName + "/*"
	}
	query := fmt.Sprintf(`items.find({
    "type": "file",
    "name": "manifest.json",
    "path": {"$match": "*/%s"}
    }).include("repo", "path", "name", "created", "type", "property")`, pathPattern)
	return query
}

// fetchArtifacts sends an AQL query to Artifactory and returns the found artifacts
func fetchArtifacts(client HTTPClient, query string) (AppDetails, error) {
	return executeHTTPRequest(query, artifactoryURL, token, client)
}

func executeHTTPRequest(query, url, token string, client HTTPClient) (AppDetails, error) {
	//fmt.Println(query)
	payload := strings.NewReader(query)
	req, err := http.NewRequest("POST", fmt.Sprintf("%s/artifactory/api/search/aql", url), payload)
	if err != nil {
		return AppDetails{}, err
	}

	//req.Header.Set("X-JFrog-Art-Api", token)
	req.Header.Set("Authorization", "Bearer "+token)
	req.Header.Set("Content-Type", "text/plain")

	var resp *http.Response
	for i := 0; i < 3; i++ {
		resp, err = client.Do(req)
		if err != nil {
			fmt.Printf("Error %v\n", err)
			continue
		} else if err == nil {
			break
		}

		if resp.StatusCode == http.StatusTooManyRequests {
			time.Sleep(time.Millisecond * 500)
		}
	}
	defer resp.Body.Close()

	body, err := io.ReadAll(resp.Body)
	fmt.Println(string(body))
	if err != nil {
		return AppDetails{}, err
	}

	if len(body) == 0 {
		return AppDetails{}, nil
	}

	var result AppDetails
	err = json.Unmarshal(body, &result)
	if err != nil {
		return AppDetails{}, err
	}
	return result, nil
}
