type Artifact struct {
	Repo       string     `json:"repo"`
	Path       string     `json:"path"`
	Name       string     `json:"name"`
	Type       string     `json:"type"`
	Created    string     `json:"created"`
	Properties []Property `json:"properties"`
}

type Property struct {
	Key   string `json:"key"`
	Value string `json:"value"`
}

type Range struct {
	StartPos int `json:"start_pos"`
	EndPos   int `json:"end_pos"`
	Total    int `json:"total"`
	Limit    int `json:"limit"`
}

type AppDetails struct {
	Results []Artifact `json:"results"`
	Range   Range      `json:"range"`
}

type HTTPClient interface {
	Do(req *http.Request) (*http.Response, error)
}

func main() {
	// Read artifact names from input file
	artifactNames, err := readLines(inputFile)
	if err != nil {
		fmt.Printf("Error reading input file: %v\n", err)
		return
	}

	// Create a file to write not found artifact names (optional, can be removed if not needed)
	// notFound, err := os.Create(notFoundFile)
	// if err != nil {
	// 	fmt.Printf("Error creating not found file: %v\n", err)
	// 	return
	// }
	// defer notFound.Close()

	// Create a JSON file to write artifact results
	jsonOutputFile := "ICEprism-ui.json"
	output, err := os.Create(jsonOutputFile)
	if err != nil {
		fmt.Printf("Error creating output file: %v\n", err)
		return
	}
	defer output.Close()

	client := &http.Client{
		Timeout: time.Second * 500,
	}

	// Deduplicate artifacts by Name+Path, prefer 'rm-shared' over 'rm-shared-maven'
	type dedupKey struct {
		Name string
		Path string
	}
	deduped := make(map[dedupKey]Artifact)

	for _, line := range artifactNames {
		name, version, ok := parseInputLine(line)
		if !ok {
			fmt.Printf("Skipping invalid input line: %s\n", line)
			continue
		}

		// Query for regular file artifacts (rpm, jar, nupkg, etc.)
		fileQuery := constructAQLQuery(name, version)
		if foundArtifacts, err := fetchArtifacts(client, fileQuery); err != nil {
			fmt.Printf("Error fetching artifact %s: %v\n", line, err)
		} else {
			for _, artifact := range foundArtifacts.Results {
				key := dedupKey{artifact.Name, artifact.Path}
				if prev, exists := deduped[key]; !exists || len(artifact.Properties) > len(prev.Properties) {
					deduped[key] = artifact
				}
			}
		}

		// Also query for Docker images (stored as manifest.json under <name>/<version>/)
		dockerQuery := constructDockerAQLQuery(name, version)
		if foundDocker, err := fetchArtifacts(client, dockerQuery); err != nil {
			fmt.Printf("Error fetching docker artifact %s: %v\n", line, err)
		} else {
			for _, artifact := range foundDocker.Results {
				key := dedupKey{artifact.Name, artifact.Path}
				if prev, exists := deduped[key]; !exists || len(artifact.Properties) > len(prev.Properties) {
					deduped[key] = artifact
				}
			}
		}
	}

	// Prepare output in AppDetails format
	var outputArtifacts []Artifact
	for _, artifact := range deduped {
		outputArtifacts = append(outputArtifacts, artifact)
	}

	// Optionally, sort outputArtifacts by Name/Path if desired

	// Write to JSON file
	appDetails := AppDetails{
		Results: outputArtifacts,
		Range: Range{
			StartPos: 0,
			EndPos:   len(outputArtifacts) - 1,
			Total:    len(outputArtifacts),
			Limit:    len(outputArtifacts),
		},
	}
	encoder := json.NewEncoder(output)
	encoder.SetIndent("", "  ")
	if err := encoder.Encode(appDetails); err != nil {
		fmt.Printf("Error writing JSON output: %v\n", err)
		return
	}
}

// readLines reads a whole file into memory and returns a slice of its lines.
func readLines(path string) ([]string, error) {
	file, err := os.Open(path)
	if err != nil {
		return nil, err
	}
	defer file.Close()

	var lines []string
	scanner := bufio.NewScanner(file)
	for scanner.Scan() {
		lines = append(lines, scanner.Text())
	}
	return lines, scanner.Err()
}

